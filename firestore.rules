rules_version = '2';

// Cole estas regras em: Firebase Console > Firestore Database > Regras > Publicar.
// ANTES de publicar, troque o e-mail abaixo pelos e-mails (Google) que podem usar o painel.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'TROQUE-PELO-EMAIL-DO-RESPONSAVEL@gmail.com'
        ];
    }

    function pedidoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'nome', 'tipo', 'endereco', 'taxaEntrega', 'taxaAConfirmar', 'pagamento',
          'trocoPara', 'marmitas', 'bebidas', 'observacoes', 'subtotal', 'total',
          'status', 'createdAt'
        ])
        && d.keys().hasAll([
          'nome', 'tipo', 'endereco', 'pagamento', 'marmitas', 'bebidas',
          'subtotal', 'total', 'status', 'createdAt'
        ])
        && d.nome is string && d.nome.size() >= 1 && d.nome.size() <= 80
        && d.tipo in ['entrega', 'retirada']
        && d.endereco is map
        && d.pagamento in ['pix', 'dinheiro', 'cartao']
        && (d.trocoPara == null || (d.trocoPara is int && d.trocoPara > 0 && d.trocoPara < 1000000))
        && (d.taxaEntrega == null || (d.taxaEntrega is int && d.taxaEntrega >= 0 && d.taxaEntrega < 100000))
        && d.marmitas is list && d.marmitas.size() <= 20
        && d.bebidas is list && d.bebidas.size() <= 30
        && (d.marmitas.size() + d.bebidas.size()) >= 1
        && d.subtotal is int && d.subtotal > 0 && d.subtotal < 1000000
        && d.total is int && d.total > 0 && d.total < 1000000
        && (!('observacoes' in d) || (d.observacoes is string && d.observacoes.size() <= 300))
        && d.status == 'novo'
        && d.createdAt == request.time;
    }

    // Cardápio e configurações: qualquer pessoa lê (precisa para montar o pedido); só o responsável altera.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos: o cliente só consegue CRIAR (e nunca ler); o responsável lê e altera.
    match /orders/{orderId} {
      allow create: if pedidoValido();
      allow read, update, delete: if isAdmin();
    }

    // Contador do número da comanda
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }
  }
}
