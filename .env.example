# Copie para .env.local (uso local) e cadastre os mesmos nomes no Vercel
# (Project > Settings > Environment Variables).
# Esses valores vêm de: Firebase Console > Configurações do projeto > Seus apps > App da Web.
# Eles são públicos por natureza; a proteção dos dados está nas regras do Firestore.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
